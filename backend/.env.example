# Copiez ce fichier en .env et adaptez les valeurs. Ne jamais committer .env.
DJANGO_SECRET_KEY=changez-cette-cle-en-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# PostgreSQL (recommandé) :
# DATABASE_URL=postgres://ksg:motdepasse@localhost:5432/konate_gym
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
CORS_ALLOW_ALL_ORIGINS=True
ADMIN_2FA_REQUIRED=True
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
